# Copy this file to .env and fill in real values there.
# .env is gitignored; .env.example (this file) is committed and must never
# contain a real secret — placeholders/blank values only.

# --- Retrieval (RAG) ---
CHROMA_DB_PATH=./data/chroma
# Optional: leave blank to use the local offline embedding model instead.
OPENAI_API_KEY=

# --- LLM generation ---
# LLM_PROVIDER selects which config block below is used: nvidia_nim | openai | opencode_zen
LLM_PROVIDER=nvidia_nim
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=

# opencode.ai Zen router - OpenAI-compatible, no API key required.
OPENCODE_ZEN_MODEL=big-pickle

# --- Observability ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# --- Frontend ---
API_BASE_URL=http://localhost:8000
TRACE_VIEWER_URL=http://localhost:6006
